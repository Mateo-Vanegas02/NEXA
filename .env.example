# Copia este archivo a .env (en la raiz del proyecto) y completa los valores. NUNCA subas .env a git.
# Spring Boot lo carga solo al arrancar. Formato CLAVE=valor, SIN comillas y sin espacios alrededor del '='.
# Las variables de entorno reales del sistema (Azure, Docker) tienen prioridad sobre este archivo.
# Solo nombres: ningun valor real debe vivir en el repositorio.

# Cadena de conexion de MongoDB (Atlas o local)
MONGODB_URI=

# Secreto HMAC del JWT: Base64, minimo 256 bits. Genera uno: openssl rand -base64 48
JWT_SECRET=

# API key de Google Gemini (chatbot)
GEMINI_API_KEY=

# Cuenta SMTP (Gmail) para correos de recuperacion de contrasena
SPRING_MAIL_USERNAME=
# Para Gmail usa una "contrasena de aplicacion", no la contrasena de la cuenta
SPRING_MAIL_PASSWORD=

# URL publica de la app (obligatoria en produccion), sin barra final. Ej: https://tu-dominio
APP_BASE_URL=

# Perfil: dev (logging detallado, solo local) | prod
SPRING_PROFILES_ACTIVE=dev

# OPCIONAL: crea el administrador inicial al arrancar si no existe (password >= 12 caracteres).
# Quitalas de la configuracion una vez creado el admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
