# Tarea de entrenamiento del modelo de satisfacción (ECS Fargate). La construye y la sube a ECR
# .github/workflows/imagen-entrenamiento.yml. Corre `python -m nexa_ml.entrenadora` con ENTRENAMIENTO_ID.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements-entrenamiento.txt .
RUN pip install --no-cache-dir -r requirements-entrenamiento.txt

COPY nexa_ml ./nexa_ml

RUN useradd --create-home --uid 10001 nexa
USER nexa

ENTRYPOINT ["python", "-m", "nexa_ml.entrenadora"]
