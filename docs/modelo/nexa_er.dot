  cred [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#b4691f"><FONT COLOR="white" POINT-SIZE="13"><B>creditos_nexa</B></FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#eef1f5"><FONT POINT-SIZE="9" COLOR="#4a5360"><I>cashback</I></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#b00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">String</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1f4e8c"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">usuarioId</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">→ Usuarios._id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1f4e8c"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">viajeId</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">→ Servicios.id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">monto · restante</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">double</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">creadoEn · venceEn</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">DateTime</FONT></TD></TR></TABLE>>];
  aud [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#5b6470"><FONT COLOR="white" POINT-SIZE="13"><B>auditoria_verificacion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#b00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">String</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1f4e8c"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">conductorEmail</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">→ Conductor.email (lógica)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1f4e8c"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">adminEmail</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">→ Admin.email (lógica)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">accion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">VERIFICACION_AUTOMATICA | VERIFICACION_MANUAL | APROBADO | RECHAZADO</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">resultado · resultadoPlaca · resultadoDocumento</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">String</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fuente · placa · documentoEnmascarado · motivo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">String</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fecha</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">DateTime</FONT></TD></TR></TABLE>>];
  notas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#5b6470"><FONT COLOR="white" POINT-SIZE="13"><B>NotasAdmin</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#b00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">ObjectId</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">titulo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">String</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">contenido</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">String</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fechaCreacion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">DateTime</FONT></TD></TR></TABLE>>];
  ml [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#5b6470"><FONT COLOR="white" POINT-SIZE="13"><B>info_modelos_ml</B></FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#eef1f5"><FONT POINT-SIZE="9" COLOR="#4a5360"><I>modelo J48 de satisfacción</I></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#b00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">String</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombreModelo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">String</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fechaEntrenamiento</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">arbolDecisionTexto</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">String</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">instanciasUsadas · totalSatisfactorios · totalInsatisfactorios</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">int</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">promedioTarifa / Distancia (Si, No)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#6b7480">double</FONT></TD></TR></TABLE>>];
  leyenda [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a3" BGCOLOR="#fafbfc">
<TR><TD COLSPAN="2"><B>Leyenda</B></TD></TR>
<TR><TD><FONT COLOR="#b00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT">clave primaria (_id)</TD></TR>
<TR><TD><FONT COLOR="#1f4e8c"><B>FK</B></FONT></TD><TD ALIGN="LEFT">referencia a otra colección (MongoDB no impone la FK)</TD></TR>
<TR><TD><FONT COLOR="#7a4fb5"><B>UK</B></FONT></TD><TD ALIGN="LEFT">índice único</TD></TR>
<TR><TD BGCOLOR="#1f4e8c"><FONT COLOR="white">  </FONT></TD><TD ALIGN="LEFT">usuarios (una sola colección "Usuarios")</TD></TR>
<TR><TD BGCOLOR="#1d7a5f"><FONT COLOR="white">  </FONT></TD><TD ALIGN="LEFT">operación: vehículos y viajes</TD></TR>
<TR><TD BGCOLOR="#b4691f"><FONT COLOR="white">  </FONT></TD><TD ALIGN="LEFT">niveles, XP y beneficios</TD></TR>
<TR><TD BGCOLOR="#5b6470"><FONT COLOR="white">  </FONT></TD><TD ALIGN="LEFT">administración y ML</TD></TR>
<TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9">Pata de gallo = muchos · barras = uno · círculo = opcional</FONT></TD></TR>
</TABLE>>];
  pasajero -> usuarios [arrowhead=empty, arrowsize=1.3, color="#1f4e8c", penwidth=1.6, label=<<FONT POINT-SIZE="9" COLOR="#1f4e8c">hereda</FONT>>];
  conductor -> usuarios [arrowhead=empty, arrowsize=1.3, color="#1f4e8c", penwidth=1.6, label=<<FONT POINT-SIZE="9" COLOR="#1f4e8c">hereda</FONT>>];
  admin -> usuarios [arrowhead=empty, arrowsize=1.3, color="#1f4e8c", penwidth=1.6, label=<<FONT POINT-SIZE="9" COLOR="#1f4e8c">hereda</FONT>>];
  conductor -> vehiculos [dir=both, arrowtail=teetee, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#2b3340">posee 1:N</FONT>>, style=solid, color="#3b4452"];
  pasajero -> servicios [dir=both, arrowtail=teetee, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#2b3340">solicita 1:N</FONT>>, style=solid, color="#3b4452"];
  conductor -> servicios [dir=both, arrowtail=teeodot, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#2b3340">atiende 0..1:N</FONT>>, style=solid, color="#3b4452"];
  vehiculos -> servicios [dir=both, arrowtail=teeodot, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#2b3340">se usa en 0..1:N</FONT>>, style=solid, color="#3b4452"];
  pasajero -> conductor [dir=both, arrowtail=crowodot, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#2b3340">favoritos N:M</FONT>>, style=solid, color="#3b4452", constraint=false];
  usuarios -> xp [dir=both, arrowtail=teetee, arrowhead=crowodot, label="", style=solid, color="#b4691f"];
  servicios -> xp [dir=both, arrowtail=teetee, arrowhead=crowodot, label="", style=solid, color="#b4691f"];
  usuarios -> ben [dir=both, arrowtail=teetee, arrowhead=crowodot, label="", style=solid, color="#b4691f"];
  servicios -> ben [dir=both, arrowtail=teetee, arrowhead=crowodot, label="", style=solid, color="#b4691f"];
  usuarios -> cred [dir=both, arrowtail=teetee, arrowhead=crowodot, label="", style=solid, color="#b4691f"];
  servicios -> cred [dir=both, arrowtail=teetee, arrowhead=crowodot, label="", style=solid, color="#b4691f"];
  conductor -> aud [dir=both, arrowtail=teetee, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#2b3340">email (lógica)</FONT>>, style=dashed, color="#5b6470"];
  admin -> aud [dir=both, arrowtail=teeodot, arrowhead=crowodot, label=<<FONT POINT-SIZE="10" COLOR="#2b3340">email (lógica)</FONT>>, style=dashed, color="#5b6470"];
  servicios -> desglose [arrowhead=none, arrowtail=diamond, dir=back, style=dashed, color="#1d7a5f", label=<<FONT POINT-SIZE="10">embebe 1:1</FONT>>];
  {rank=same; notas; ml; leyenda}
  notas -> ml [style=invis]
  ml -> leyenda [style=invis]
}
